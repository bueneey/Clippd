# Copy to .env and change what you need. Never commit real keys.

PORT=5173

# Solana RPC. Put a private Helius/QuickNode URL here if public RPC rate-limits you.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC_FALLBACK=https://solana-rpc.publicnode.com
SOLANA_RPC_FALLBACK_2=https://rpc.ankr.com/solana

# Optional. If set, used as first RPC: https://mainnet.helius-rpc.com/?api-key=...
HELIUS_API_KEY=

# Live SOL/USD quote
PRICE_URL=https://api.coingecko.com/api/v3/simple/price?ids=solana&vs_currencies=usd
PRICE_URL_FALLBACK=https://lite-api.jup.ag/price/v2?ids=So11111111111111111111111111111111111111112

MIN_BUDGET_USD=10
